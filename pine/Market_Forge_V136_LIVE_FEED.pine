//@version=6
indicator("Market Forge V136 LIVE RESEARCH FEED", overlay=false, dynamic_requests=true)
enabled = input.bool(false, "Enable NEW TEST webhook")
bank = input.int(1, "Bank", minval=1, maxval=2)
secret = input.string("", "Webhook secret")
if barstate.isfirst and (not chart.is_standard or timeframe.in_seconds() != 60)
    runtime.error("Use standard SPY 1 minute chart")
f_recent() =>
    string result = ""
    for offset = 1 to 5
        if session.ismarket[offset] and not na(close[offset]) and volume[offset] > 0
            string row = '["' + syminfo.ticker + '",' + str.tostring(time_close[offset]) + ',' + str.tostring(open[offset], "#.########") + ',' + str.tostring(high[offset], "#.########") + ',' + str.tostring(low[offset], "#.########") + ',' + str.tostring(close[offset], "#.########") + ',' + str.tostring(volume[offset], "#.########") + ']'
            result += (str.length(result) > 0 ? "," : "") + row
    result
var universe = str.split(bank == 1 ? "SPY,QQQ,NVDA,TSLA,AVGO,AMD,META,AAPL,MSFT,AMZN" : "PLTR,PANW,SNDK,GOOG,RDDT,HOOD,COIN,JPM,AXP,V", ",")
varip int lastSent = 0
string packet = ""
for symbol in universe
    string source = ticker.modify("BATS:" + symbol, session=session.extended)
    string rows = request.security(source, "1", f_recent(), lookahead=barmerge.lookahead_on, ignore_invalid_symbol=false)
    if not na(rows) and str.length(rows) > 0
        packet += (str.length(packet) > 0 ? "," : "") + rows
// Previous closed bars only; repeated five-minute window allows short-gap recovery.
bool marketWindow = not na(time(timeframe.period, "0931-1602:23456", "America/New_York"))
if barstate.isrealtime and enabled and str.length(secret) > 0 and timenow - lastSent >= (marketWindow ? 20000 : 60000)
    string safeSecret = str.replace_all(str.replace_all(secret, '\\', '\\\\'), '"', '\\"')
    alert('{"secret":"' + safeSecret + '","source":"MF_V136_RESEARCH_LIVE_1","bank":' + str.tostring(bank) + ',"emitted":' + str.tostring(timenow) + ',"bars":[' + (marketWindow ? packet : "") + ']}', alert.freq_all)
    lastSent := timenow
var table panel = table.new(position.top_right, 1, 3)
if barstate.islast
    table.cell(panel, 0, 0, "V136 RESEARCH · BANK " + str.tostring(bank))
    table.cell(panel, 0, 1, enabled ? "FEED ENABLED · CREATE ALERT" : "FEED OFF")
    table.cell(panel, 0, 2, "BATS 1m · 10 symbols · no orders")
plot(na, display=display.none)
